# TAVI Backend Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit .env to source control!

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=https://tavi-financial-app.onrender.com,https://teeblee512.github.io,http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_at_least_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://tavi_user:tavi_password@localhost:5432/tavi_db?schema=public

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
